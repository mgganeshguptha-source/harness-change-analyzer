# api/pricing.yaml
openapi: 3.0.3
info:
  title: pricing-service API
  version: v1
  description: Leaf provider. Owns book pricing and the discountTier field.
servers:
  - url: http://localhost:8083
paths:
  /pricing/{bookId}:
    get:
      summary: Get price for a book
      operationId: getPrice
      parameters:
        - name: bookId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Price found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Price'
        '404':
          description: Book not priced
components:
  schemas:
    Price:
      type: object
      required: [bookId, basePrice, currency, discountTier]
      properties:
        bookId:
          type: string
          example: B001
        basePrice:
          type: number
          format: double
          example: 29.99
        currency:
          type: string
          example: USD
        discountTier:
          type: string
          description: Pricing tier used downstream to compute effective price.
          enum: [STANDARD, PREMIUM]
          example: STANDARD


